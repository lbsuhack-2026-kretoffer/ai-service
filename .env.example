# Backend environment
DATABASE_URL=postgresql+psycopg2://school:school@db:5432/school_balance
SECRET_KEY=dev-secret
SESSION_COOKIE=sb_session
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
ML_SERVICE_URL=http://ai-service:8000
SEED_DEMO=true

# AI-service specific
# Категории шведского стола через запятую (без пробелов после запятой)
BUFFET_CATEGORIES=hot,salad,bakery

# Дополнительные даты каникул/праздников (JSON-массив ISO-дат), дополняют встроенный набор
# HOLIDAY_CALENDAR=["2026-10-30","2026-12-31"]

# Коэффициенты категорий буфета для синтетической генерации (только фолбэк, не инференс).
# Берутся из env BUFFET_RATIO_<КАТЕГОРИЯ_В_ВЕРХНЕМ_РЕГИСТРЕ>, иначе равномерное распределение.
# BUFFET_RATIO_HOT=0.42
# BUFFET_RATIO_SALAD=0.18
# BUFFET_RATIO_BAKERY=0.22

# Параметры синтетического фолбэка (используется только если БД недоступна)
SYNTHETIC_SCHOOLS_COUNT=6
SYNTHETIC_CLASSES_PER_SCHOOL=6
